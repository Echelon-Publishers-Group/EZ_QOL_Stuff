   size 0.92 0.1
   text "-"
   font "gui/fonts/metron28"
  }
  TextWidgetClass LockText {
   position 0.04 0.28
   size 0.92 0.07
   text ""
  }
  ButtonWidgetClass ParkButton {
   position 0.04 0.45
   size 0.28 0.12
   text "#STR_EZ_QOL_ACT_PARK"
  }
  ButtonWidgetClass RetrieveButton {
   position 0.36 0.45
   size 0.28 0.12
   text "#STR_EZ_QOL_ACT_RETRIEVE"
  }
  ButtonWidgetClass RefreshButton {
   position 0.68 0.45
   size 0.28 0.12
