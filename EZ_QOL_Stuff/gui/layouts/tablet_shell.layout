FrameWidgetClass TabletShellRoot {
 position 0.5 0.5
 size 0.62 0.72
 halign center_ref
 valign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass Bezel {
   position 0 0
   size 1 1
   color 0.03 0.03 0.04 1
   style rover_sim_colorable
  }
  PanelWidgetClass Screen {
   position 0.03 0.04
   size 0.94 0.92
   color 0.06 0.08 0.1 1
   style rover_sim_colorable
   {
    TextWidgetClass TitleText {
     position 0.02 0.01
     size 0.6 0.07
     text "EZ Tablet"
     font "gui/fonts/metron28"
    }
    ButtonWidgetClass BackButton {
     visible 0
     position 0.66 0.01
     size 0.15 0.07
     text "Back"
    }
    ButtonWidgetClass CloseButton {
     position 0.83 0.01
     size 0.15 0.07
     text "Close"
    }
    FrameWidgetClass Home {
     position 0.02 0.1
     size 0.96 0.88
     {
      WrapSpacerWidgetClass AppList {
       position 0 0
       size 1 1
       Padding 8
       Margin 8
      }
     }
    }
    FrameWidgetClass AppContent {
     visible 0
     position 0.02 0.1
     size 0.96 0.88
    }
   }
  }
 }
}
